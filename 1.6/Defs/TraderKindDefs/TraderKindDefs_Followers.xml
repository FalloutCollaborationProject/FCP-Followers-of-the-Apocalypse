<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Followers of the Apocalypse Trader Definitions __________-->

    <!-- Aid Caravan: medicine, food, and cloth only - the Followers do not deal in weapons or armor -->

    <TraderKindDef>
        <defName>FCP_Trader_Followers_Aid_Caravan</defName>
        <label>Followers aid caravan</label>
        <commonality>1.0</commonality>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>200~500</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Cloth</thingDef>
                <countRange>30~80</countRange>
            </li>

            <!-- Medicine -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineHerbal</thingDef>
                <countRange>10~25</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineIndustrial</thingDef>
                <countRange>15~35</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineUltratech</thingDef>
                <countRange>2~6</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Neutroamine</thingDef>
                <countRange>10~25</countRange>
            </li>

            <!-- Followers Lab Coat -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>FCP_Apparel_Lab_Coat_Followers</thingDef>
                <countRange>1~3</countRange>
            </li>

            <!-- Food aid -->
            <li Class="StockGenerator_Category">
                <categoryDef>Foods</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>150~350</totalPriceRange>
            </li>

            <!-- Donated clothing -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>BasicClothing</tradeTag>
                <countRange>2~5</countRange>
            </li>

            <!-- Buying: the Followers will take supplies off your hands, but never weapons or armor -->
            <li Class="StockGenerator_Category">
                <categoryDef>Medicine</categoryDef>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Foods</categoryDef>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Textiles</categoryDef>
            </li>

        </stockGenerators>
    </TraderKindDef>

</Defs>
