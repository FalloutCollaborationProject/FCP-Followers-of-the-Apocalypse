<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Enlistments with Factions __________-->

    <!--_____ Followers of the Apocalypse _____-->

    <FCP.Enlist.FactionEnlistOptionsDef>
        <defName>FCP_Enlistment_Followers</defName>
        <label>Followers of the Apocalypse</label>
        <minGoodwillRequrementToEnlist>10</minGoodwillRequrementToEnlist>
        <enlistGoodwillGain>5</enlistGoodwillGain>
        <minGoodwillUponEnlist>75</minGoodwillUponEnlist>

        <!-- Enlistment Options -->

        <enlistLetterTitleKey>FCP_Followers_Enlist_Letter_Title</enlistLetterTitleKey>
        <enlistLetterLabelKey>FCP_Followers_Enlist_Letter_Label</enlistLetterLabelKey>
        <enlistButtonLabelKey>FCP_Followers_Enlist_Button_Label</enlistButtonLabelKey>
        <enlistButtonDescKey>FCP_Followers_Enlist_Button_Desc</enlistButtonDescKey>
        <enlistRequrementsNotSatisfiedKey>FCP_Followers_Enlist_Requrements_Not_Satisfied</enlistRequrementsNotSatisfiedKey>
        <enlistedToHostileFactionKey>FCP_Followers_Enlisted_To_Hostile_Faction</enlistedToHostileFactionKey>
        <enlistButtonIconTexPath>UI/Memes/Loyalist</enlistButtonIconTexPath>
        <enlistedSoundDef>FCP_Sound_Card_Use</enlistedSoundDef>
        <enlistedWithKey>FCP_Followers_Enlisted_With_Key</enlistedWithKey>

        <!-- Mission Options -->

        <missionsAreEnabled>true</missionsAreEnabled>
        <missionsLabelKey>FCP_Followers_Missions_Label</missionsLabelKey>
        <missionsDescKey>FCP_Followers_Missions_Desc</missionsDescKey>
        <missionsButtonIconTexPath>UI/Icons/ThingCategories/Medicine</missionsButtonIconTexPath>
        <missionsBackgroundMenuTexPath>UI/Icons/ThingCategories/Medicine</missionsBackgroundMenuTexPath>
        <missionsMenuDescriptionKey>FCP_Followers_Menu_Missions_Desc</missionsMenuDescriptionKey>
        <missionsMenuSelectQuestKey>FCP_Followers_Menu_Missions_Select_Quest</missionsMenuSelectQuestKey>
        <missionsMenuStartQuestKey>FCP_Followers_Menu_Missions_Start_Quest</missionsMenuStartQuestKey>
        <missionsBountyRewardRange>24~64</missionsBountyRewardRange>
        <missionsMenuCollectBountyKey>FCP_Followers_Menu_Missions_Collect_Bounty</missionsMenuCollectBountyKey>

        <!-- Salary Options -->

        <salaryIsEnabled>true</salaryIsEnabled>
        <salaryDef>FCP_Currency_Caps</salaryDef>
        <salaryLabelKey>FCP_Followers_Salary_Label</salaryLabelKey>
        <salaryDescKey>FCP_Followers_Salary_Desc</salaryDescKey>
        <salaryButtonIconTexPath>Things/Items/Currencies/FCP_Bottle_Caps_Currency/FCP_Bottle_Caps_Currency_a</salaryButtonIconTexPath>
        <salaryRange>150~350</salaryRange>
        <salaryPeriodDays>14</salaryPeriodDays>

        <!-- Provision Options -->

        <provisionOptions>
            <li>
                <provisionsLabelKey>FCP_Followers_Provisions_Label</provisionsLabelKey>
                <provisionsDescKey>FCP_Followers_Provisions_Desc</provisionsDescKey>
                <provisionsButtonIconTexPath>UI/Icons/ThingCategories/Medicine</provisionsButtonIconTexPath>
                <provisions>
                    <li>
                        <thing>MedicineIndustrial</thing>
                        <amountRange>4~10</amountRange>
                    </li>
                    <li>
                        <thing>MealSurvivalPack</thing>
                        <amountRange>10~16</amountRange>
                    </li>
                </provisions>
                <provisionsRestockInDays>10</provisionsRestockInDays>
            </li>
        </provisionOptions>

        <!-- Storage Options -->

        <storageIsEnabled>true</storageIsEnabled>
        <storageLabelKey>FCP_Followers_Storage_Label</storageLabelKey>
        <storageDescKey>FCP_Followers_Storage_Desc</storageDescKey>
        <storageButtonIconTexPath>UI/Icons/ThingCategories/ResourcesRaw</storageButtonIconTexPath>

        <!-- Work Options -->

        <recreationGainPerTick>0.0001</recreationGainPerTick>
        <workOptions>
            <li>
                <workLabelKey>FCP_Followers_Clinic_Duty_Label</workLabelKey>
                <workDescKey>FCP_Followers_Clinic_Duty_Desc</workDescKey>
                <workButtonIconTexPath>UI/Icons/ThingCategories/Medicine</workButtonIconTexPath>
                <additionalRestFall>0.2</additionalRestFall>
                <tendCaravanMembersEveryTicks>600</tendCaravanMembersEveryTicks>
                <medicinesToTend>
                    <li>MedicineIndustrial</li>
                </medicinesToTend>
                <immunityGainSpeedMultiplier>1.5</immunityGainSpeedMultiplier>
            </li>
            <li>
                <workLabelKey>FCP_Followers_Archive_Duty_Label</workLabelKey>
                <workDescKey>FCP_Followers_Archive_Duty_Desc</workDescKey>
                <workButtonIconTexPath>UI/Roles/SpecialistProduction</workButtonIconTexPath>
                <experienceGainsPerHour>
                    <Intellectual>400</Intellectual>
                    <Social>200</Social>
                </experienceGainsPerHour>
                <additionalRestFall>0.15</additionalRestFall>
            </li>
            <li>
                <workLabelKey>FCP_Followers_Aid_Rounds_Label</workLabelKey>
                <workDescKey>FCP_Followers_Aid_Rounds_Desc</workDescKey>
                <workButtonIconTexPath>UI/Roles/SpecialistSocial</workButtonIconTexPath>
                <additionalRestFall>0.25</additionalRestFall>
                <silverGainPerHour>6</silverGainPerHour>
            </li>
        </workOptions>

        <!-- Resign Options -->

        <resignGoodwillGain>-25</resignGoodwillGain>
        <resignMenuTextKey>FCP_Followers_Resign_Menu_Text</resignMenuTextKey>
        <resignLetterTitleKey>FCP_Followers_Resign_Letter_Title</resignLetterTitleKey>
        <resignLetterLabelKey>FCP_Followers_Resign_Letter_Label</resignLetterLabelKey>
        <resignButtonLabelKey>FCP_Followers_Resign_Button_Label</resignButtonLabelKey>
        <resignButtonDescKey>FCP_Followers_Resign_Button_Desc</resignButtonDescKey>
        <resignButtonIconTexPath>UI/Issues/Apostasy</resignButtonIconTexPath>

        <!-- Kicked Out Options -->

        <kickOutLetterTitleKey>FCP_Followers_Kick_Out_Letter_Title</kickOutLetterTitleKey>
        <kickOutLetterLabelKey>FCP_Followers_Kick_Out_Label_Title</kickOutLetterLabelKey>

        <!-- Reinforcements Options -->

        <reinforcementsAreEnabled>false</reinforcementsAreEnabled>

    </FCP.Enlist.FactionEnlistOptionsDef>

</Defs>
