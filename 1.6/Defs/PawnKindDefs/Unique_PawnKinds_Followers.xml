            <li>FCP_Apparel_Lab_Coat_Followers</li>
        </apparelRequired>
        <weaponTags>
            <li>Gun</li>
            <li MayRequire="Rick.FCP.BallisticWeapons">FCP_Pistol</li>
        </weaponTags>
        <requiredWorkTags>
            <li>Social</li>
        </requiredWorkTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Character_Backstory_Farkas_Child</li>
