<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Followers of the Apocalypse Titles __________-->

    <!-- Volunteer -->

    <RoyalTitleDef ParentName="FCP_Base_Empire_Titles">
        <defName>FCP_Title_Followers_Volunteer</defName>
        <label>volunteer</label>
        <description>New to the chapter, taken in and put to work wherever an extra pair of hands is needed.</description>
        <tags>
            <li>FCP_Title_Followers</li>
        </tags>
        <seniority>0</seniority>
        <favorCost>1</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>1</permitPointsAwarded>
    </RoyalTitleDef>

    <!-- Aide -->

    <RoyalTitleDef ParentName="FCP_Base_Empire_Titles">
        <defName>FCP_Title_Followers_Aide</defName>
        <label>aide</label>
        <description>Volunteers trusted to work the wards and the archive both. Most stay on the medical path; a few take up a rifle instead.</description>
        <tags>
            <li>FCP_Title_Followers</li>
        </tags>
        <seniority>150</seniority>
        <favorCost>4</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>1</permitPointsAwarded>
    </RoyalTitleDef>

